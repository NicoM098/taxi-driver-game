[gd_resource type="Resource" script_class="PassengerProfile" format=3]

[ext_resource type="Script" path="res://src/core/resources/passenger_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://src/core/resources/examinable.gd" id="2_exam"]
[ext_resource type="Script" path="res://src/core/resources/passenger_action.gd" id="3_action"]
[ext_resource type="Script" path="res://src/events/ride_event.gd" id="4_event"]
[ext_resource type="Script" path="res://src/events/dialogue_event.gd" id="5_dialogue"]
[ext_resource type="Script" path="res://src/events/timer_modifier_event.gd" id="6_timer"]
[ext_resource type="Script" path="res://src/events/reward_event.gd" id="7_reward"]

[sub_resource type="Resource" id="Exam_breathing"]
script = ExtResource("2_exam")
id = &"breathing"
label = "her breathing"
reveal_text = "Contractions ninety seconds apart. This baby is not waiting for traffic."
time_cost = 2.0
reveals_traits = Array[StringName]([&"in_labour"])

[sub_resource type="Resource" id="Action_rush"]
script = ExtResource("3_action")
id = &"rush"
label = "Promise to make it in time (double fare)"
outcome = 0
requires_traits = Array[StringName]([&"in_labour"])
fare_mult = 2.0
time_mult = 0.85
result_text = "\"Go! Go go go!\""

[sub_resource type="Resource" id="Event_bark_1"]
script = ExtResource("5_dialogue")
trigger = 3
trigger_value = 0.25
lines = PackedStringArray("Hff... hff... faster, please!", "Can this thing go any faster?!")

[sub_resource type="Resource" id="Event_contraction"]
script = ExtResource("6_timer")
trigger = 3
trigger_value = 0.5
trigger_random = 0.1
chance = 0.6
add_seconds = -4.0
line = "AAAH! Contraction!"

[sub_resource type="Resource" id="Event_bark_2"]
script = ExtResource("5_dialogue")
trigger = 3
trigger_value = 0.8
lines = PackedStringArray("IT'S COMING!", "I am NOT having this baby in a taxi!")

[sub_resource type="Resource" id="Event_thanks"]
script = ExtResource("7_reward")
trigger = 4
kinds = Array[StringName]([&"cash"])
cash_amount = 30
line = "Thank you! THANK YOU!"

[resource]
script = ExtResource("1_profile")
id = &"expectant_mother"
display_name = "Expectant Mother"
color = Color(0.2, 0.6, 0.6, 1)
fare_base = 55
fare_per_100m = 16
tip_multiplier = 2.0
min_distance = 220.0
max_distance = 420.0
destination_districts = Array[StringName]([&"downtown"])
time_multiplier = 0.7
occupation = "Teacher (on leave, as of right now)"
name_pool = PackedStringArray("Nora Whitfield", "Priya Raman", "Carmen Ortiz", "Hannah Lindqvist", "Imani Okafor")
age_min = 24
age_max = 38
notes = "Hospital bag, one shoe on. Breathing in [url=breathing]short sharp bursts[/url]. \"The hospital. Please. Quickly.\""
examinables = Array[ExtResource("2_exam")]([SubResource("Exam_breathing")])
actions = Array[ExtResource("3_action")]([SubResource("Action_rush")])
hidden_traits = Array[StringName]([&"in_labour"])
kick_reaction = 0
kick_line = "You... you MONSTER."
ride_events = Array[ExtResource("4_event")]([SubResource("Event_bark_1"), SubResource("Event_contraction"), SubResource("Event_bark_2"), SubResource("Event_thanks")])
spawn_weight = 1.0
districts = Array[StringName]([&"suburbs", &"downtown"])
