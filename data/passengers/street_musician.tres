[gd_resource type="Resource" script_class="PassengerProfile" format=3]

[ext_resource type="Script" path="res://src/core/resources/passenger_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://src/core/resources/examinable.gd" id="2_exam"]
[ext_resource type="Script" path="res://src/core/resources/passenger_action.gd" id="3_action"]
[ext_resource type="Script" path="res://src/events/ride_event.gd" id="4_event"]
[ext_resource type="Script" path="res://src/events/dialogue_event.gd" id="5_dialogue"]
[ext_resource type="Script" path="res://src/events/spawn_pursuers_event.gd" id="6_spawn"]

[sub_resource type="Resource" id="Exam_case"]
script = ExtResource("2_exam")
id = &"case"
label = "the guitar case"
reveal_text = "No guitar. Bundles of cash and a gang's spray-painted tag on the inside of the lid. He did not earn this busking."
time_cost = 2.5
reveals_traits = Array[StringName]([&"mule"])

[sub_resource type="Resource" id="Action_take"]
script = ExtResource("3_action")
id = &"take_case"
label = "Throw him out and keep the case"
outcome = 1
requires_traits = Array[StringName]([&"mule"])
cash_delta = 110
heat_delta = 1
result_text = "He's gone. The case is heavy. Somebody is going to miss it."

[sub_resource type="Resource" id="Event_song"]
script = ExtResource("5_dialogue")
trigger = 1
trigger_value = 4.0
trigger_random = 3.0
lines = PackedStringArray("♪ Oh, the yellow cab of destiny... ♪", "You want a song? Twenty bucks. Fifty and I stop.", "♪ La la la, nobody is following us, la la la ♪")

[sub_resource type="Resource" id="Event_gang"]
script = ExtResource("6_spawn")
trigger = 3
trigger_value = 0.4
trigger_random = 0.2
chance = 0.6
count = 2
pattern = 0
enemy = "res://data/enemies/gang_coupe.tres"
line = "Uh. Those green cars? Might be looking for my... guitar."

[resource]
script = ExtResource("1_profile")
id = &"street_musician"
display_name = "Street Musician"
color = Color(0.85, 0.5, 0.2, 1)
fare_base = 20
fare_per_100m = 9
tip_multiplier = 1.4
min_distance = 160.0
max_distance = 380.0
destination_districts = Array[StringName]([&"docks"])
time_multiplier = 1.1
occupation = "Busker"
name_pool = PackedStringArray("Lou Strummer", "Benny Fingers", "Cass Delgado", "Mikey Two-Chords")
age_min = 19
age_max = 45
notes = "Fingerless gloves, harmonica on a neck brace. Hugs [url=case]a battered guitar case[/url] that clanks when he sits. Wants the docks, \"for the acoustics\"."
examinables = Array[ExtResource("2_exam")]([SubResource("Exam_case")])
actions = Array[ExtResource("3_action")]([SubResource("Action_take")])
hidden_traits = Array[StringName]([&"mule"])
kick_reaction = 0
kick_line = "Philistine!"
ride_events = Array[ExtResource("4_event")]([SubResource("Event_song"), SubResource("Event_gang")])
spawn_weight = 1.0
districts = Array[StringName]([&"downtown"])
