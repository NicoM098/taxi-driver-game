[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player_taxi"
3d_physics/layer_3="enemy_vehicles"
3d_physics/layer_4="traffic"
3d_physics/layer_5="characters"
3d_physics/layer_6="hitboxes"
3d_physics/layer_7="projectiles"
3d_physics/layer_8="triggers"
3d_physics/layer_9="props"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"

