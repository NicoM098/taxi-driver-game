extends Node
## Audio (D-066). Owns the bus layout, a pool of one-shot players and the volume API, and listens
## on the [EventBus] for everything that makes a noise but has no reason to know about audio.
##
## Nothing else in the game builds an [AudioStreamPlayer] for a one-shot: call [method play] or
## [method play_at]. Continuous sources that need per-frame control (the taxi's engine, tyres) own
## their own looping player and get the stream from [method stream].
##
## Sounds live in `res://assets/audio/`, generated by `tools/gen_sfx.py` — see that file for why.

const DIR: String = "res://assets/audio/"

const BUS_MASTER: StringName = &"Master"
const BUS_MUSIC: StringName = &"Music"
const BUS_SFX: StringName = &"SFX"
const BUS_ENGINE: StringName = &"Engine"
const BUS_UI: StringName = &"UI"
const BUS_VOICE: StringName = &"Voice"
const BUSES: Array[StringName] = [BUS_MUSIC, BUS_SFX, BUS_ENGINE, BUS_UI, BUS_VOICE]

## One-shot players are recycled round-robin. More than this many overlapping sounds and the
## oldest is cut off, which is what we want: it caps the noise in a firefight.
const POOL_FLAT: int = 10
const POOL_3D: int = 16

## In-game music, looped while a run is on (main.gd starts / stops it).
const MUSIC_TRACK: String = "res://assets/audio/Model & HLS - H Funck.mp3"
## The music sits under the effects by default; the options menu moves it.
const MUSIC_DEFAULT_DB: float = -6.0

## Volume settings (0..1 per bus), saved by the options menu.
const SETTINGS_PATH: String = "user://settings.cfg"
## Buses the options menu shows, in order, with their label. "SFX" also drives UI + Voice.
const VOLUME_SLIDERS: Array = [
	[&"Master", "Master"],
	[&"Music", "Music"],
	[&"SFX", "Effects"],
	[&"Engine", "Engine & tyres"],
]
const DEFAULT_VOLUME: float = 0.8

## Off in headless runs: the autotests must stay silent and fast.
var enabled: bool = true

var _streams: Dictionary = {}
var _flat: Array[AudioStreamPlayer] = []
var _spatial: Array[AudioStreamPlayer3D] = []
var _next_flat: int = 0
var _next_spatial: int = 0
var _music: AudioStreamPlayer = null


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS   # UI clicks still work while paused
	enabled = not _is_headless()
	_make_buses()
	load_settings()
	if not enabled:
		return
	_make_pools()
	_connect_events()


## The stream for `name` ("shot_revolver" or "shot_revolver.wav"), or null. Cached after first use.
func stream(name: StringName) -> AudioStream:
	var key := String(name)
	if not key.ends_with(".wav"):
		key += ".wav"
	if _streams.has(key):
		return _streams[key]
	var path := DIR + key
	var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
	if s == null:
		push_warning("[Audio] missing sound: " + path)
	_streams[key] = s
	return s


## Fire and forget, no position (interior / UI / feedback).
func play(name: StringName, bus: StringName = BUS_SFX, volume_db: float = 0.0,
		pitch: float = 1.0) -> void:
	if not enabled:
		return
	var s := stream(name)
	if s == null:
		return
	var p := _flat[_next_flat]
	_next_flat = (_next_flat + 1) % _flat.size()
	p.stream = s
	p.bus = String(bus)
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.play()


## Fire and forget at a world position (guns, impacts, explosions).
func play_at(name: StringName, pos: Vector3, bus: StringName = BUS_SFX, volume_db: float = 0.0,
		pitch: float = 1.0) -> void:
	if not enabled:
		return
	var s := stream(name)
	if s == null:
		return
	var p := _spatial[_next_spatial]
	_next_spatial = (_next_spatial + 1) % _spatial.size()
	p.stream = s
	p.bus = String(bus)
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.global_position = pos
	p.play()


## A looping player the caller owns and drives itself (engine, tyres). Added under `parent`.
func make_loop(name: StringName, parent: Node, bus: StringName = BUS_ENGINE) -> AudioStreamPlayer:
	var s := stream(name)
	_force_loop(s)
	var p := AudioStreamPlayer.new()
	p.stream = s
	p.bus = String(bus)
	p.volume_db = -80.0
	parent.add_child(p)
	return p


## Same, but positional: for anything that is not the player's own car (enemy engines).
func make_loop_3d(name: StringName, parent: Node, bus: StringName = BUS_ENGINE,
		max_distance: float = 70.0) -> AudioStreamPlayer3D:
	var s := stream(name)
	_force_loop(s)
	var p := AudioStreamPlayer3D.new()
	p.stream = s
	p.bus = String(bus)
	p.volume_db = -80.0
	p.max_distance = max_distance
	p.unit_size = 5.0
	parent.add_child(p)
	return p



## Godot's WAV importer loop flag (`edit/loop_mode`) does NOT survive a re-import reliably — the
## bank was generated first and imported before the flag was set, and the cached .sample won. So
## looping is forced here, on the resource, where it cannot be lost by regenerating the sounds
## (D-066 / D-067). Idempotent: `stream()` caches, so each WAV is patched once.
func _force_loop(s: AudioStream) -> void:
	var wav := s as AudioStreamWAV
	if wav == null or wav.loop_mode != AudioStreamWAV.LOOP_DISABLED:
		return
	var bytes_per_frame := 2 if wav.format == AudioStreamWAV.FORMAT_16_BITS else 1
	if wav.stereo:
		bytes_per_frame *= 2
	wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
	wav.loop_begin = 0
	wav.loop_end = int(wav.data.size() / bytes_per_frame)


## 0.0 - 1.0, driven by the options menu. The Effects slider (SFX) also sets UI and Voice.
func set_bus_volume(bus: StringName, linear: float) -> void:
	_set_one(bus, linear)
	if bus == BUS_SFX:
		_set_one(BUS_UI, linear)
		_set_one(BUS_VOICE, linear)


func _set_one(bus: StringName, linear: float) -> void:
	var idx := AudioServer.get_bus_index(String(bus))
	if idx >= 0:
		linear = clampf(linear, 0.0, 1.0)
		AudioServer.set_bus_volume_db(idx, linear_to_db(linear) if linear > 0.001 else -80.0)
		AudioServer.set_bus_mute(idx, linear <= 0.001)


func get_bus_volume(bus: StringName) -> float:
	var idx := AudioServer.get_bus_index(String(bus))
	if idx < 0:
		return 0.0
	return 0.0 if AudioServer.is_bus_mute(idx) else db_to_linear(AudioServer.get_bus_volume_db(idx))


## Applies the saved volumes (DEFAULT_VOLUME for anything never set).
func load_settings() -> void:
	var cfg := ConfigFile.new()
	cfg.load(SETTINGS_PATH)   # missing file = defaults
	for row: Array in VOLUME_SLIDERS:
		set_bus_volume(row[0], float(cfg.get_value("audio", String(row[0]), DEFAULT_VOLUME)))


func save_settings() -> void:
	var cfg := ConfigFile.new()
	cfg.load(SETTINGS_PATH)
	for row: Array in VOLUME_SLIDERS:
		cfg.set_value("audio", String(row[0]), get_bus_volume(row[0]))
	cfg.save(SETTINGS_PATH)


## Starts the in-game track, looping (no-op if it is already playing).
func play_music(path: String = MUSIC_TRACK) -> void:
	if not enabled:
		return
	if _music == null:
		_music = AudioStreamPlayer.new()
		_music.name = "Music"
		_music.bus = String(BUS_MUSIC)
		_music.volume_db = MUSIC_DEFAULT_DB
		_music.process_mode = Node.PROCESS_MODE_ALWAYS   # keeps playing in the pause menu
		add_child(_music)
	if _music.playing and _music.stream != null and _music.stream.resource_path == path:
		return
	var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
	if s == null:
		push_warning("[Audio] missing music: " + path)
		return
	if s is AudioStreamMP3:
		(s as AudioStreamMP3).loop = true
	elif s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = true
	else:
		_force_loop(s)
	_music.stream = s
	_music.play()


func stop_music() -> void:
	if _music != null:
		_music.stop()


# --- Internals -------------------------------------------------------------------------

func _is_headless() -> bool:
	return DisplayServer.get_name() == "headless" or OS.has_feature("headless")


## Buses are built here rather than shipped as a .tres so there is one source of truth and
## nothing to keep in sync; it is idempotent, so a layout added later would win.
func _make_buses() -> void:
	for bus in BUSES:
		if AudioServer.get_bus_index(String(bus)) >= 0:
			continue
		var idx := AudioServer.bus_count
		AudioServer.add_bus(idx)
		AudioServer.set_bus_name(idx, String(bus))
		AudioServer.set_bus_send(idx, String(BUS_MASTER))


func _make_pools() -> void:
	for i in POOL_FLAT:
		var p := AudioStreamPlayer.new()
		p.process_mode = Node.PROCESS_MODE_ALWAYS
		add_child(p)
		_flat.append(p)
	for i in POOL_3D:
		var p3 := AudioStreamPlayer3D.new()
		p3.max_distance = 90.0
		p3.unit_size = 6.0
		p3.process_mode = Node.PROCESS_MODE_ALWAYS
		add_child(p3)
		_spatial.append(p3)


## Everything that already announces itself on the EventBus gets its sound here, so no gameplay
## script has to learn about audio (Architecture: systems talk through signals).
func _connect_events() -> void:
	EventBus.weapon_fired.connect(_on_weapon_fired)
	EventBus.weapon_reloading.connect(func(weapon: Resource) -> void:
		# Stretch the reload sound over the weapon's own reload time.
		var data := weapon as WeaponData
		var t: float = data.reload_time if data != null else 1.0
		play(&"reload", BUS_SFX, -6.0, clampf(0.5 / maxf(t, 0.1), 0.6, 1.6)))
	EventBus.weapon_empty.connect(func(_weapon: Resource) -> void:
		play(&"empty_click", BUS_SFX, -10.0))
	EventBus.hit_confirmed.connect(func(killed: bool) -> void:
		play(&"hit_confirm", BUS_UI, -6.0, 1.15 if killed else 1.0))
	EventBus.enemy_destroyed.connect(func(enemy: Node, _bounty: int) -> void:
		var pos: Vector3 = (enemy as Node3D).global_position if enemy is Node3D else Vector3.ZERO
		play_at(&"enemy_destroyed", pos, BUS_SFX, -4.0))
	EventBus.explosion.connect(func(pos: Vector3, strength: float) -> void:
		play_at(&"explosion", pos, BUS_SFX, linear_to_db(clampf(strength, 0.2, 1.5))))
	EventBus.taxi_damaged.connect(_on_taxi_damaged)
	EventBus.taxi_wrecked.connect(func(_reason: StringName) -> void: play(&"wreck", BUS_SFX, -1.0))
	EventBus.player_hit.connect(func(_amount: float, _from: Vector3) -> void:
		play(&"player_hit", BUS_VOICE, -5.0))
	EventBus.cash_changed.connect(_on_cash_changed)
	EventBus.item_acquired.connect(func(_item: Resource) -> void: play(&"pickup", BUS_UI, -5.0))
	EventBus.energy_drink_consumed.connect(func() -> void: play(&"pickup", BUS_UI, -3.0, 0.85))
	EventBus.dossier_opened.connect(func(_p: RefCounted) -> void: play(&"ui_open", BUS_UI, -6.0))
	EventBus.dossier_closed.connect(func() -> void: play(&"ui_close", BUS_UI, -6.0))
	EventBus.dossier_action_chosen.connect(func(_p: RefCounted, _a: Resource) -> void:
		play(&"ui_click", BUS_UI, -8.0))


func _on_weapon_fired(weapon: Resource) -> void:
	var data := weapon as WeaponData
	var id := String(data.id) if data != null else ""
	var sound := &"shot_revolver"
	if id.contains("smg"):
		sound = &"shot_smg"
	elif id.contains("saw") or id.contains("shot"):
		sound = &"shot_shotgun"
	play(sound, BUS_SFX, -2.0, randf_range(0.97, 1.03))


func _on_taxi_damaged(amount: float, _hp_left: float) -> void:
	if amount <= 0.0:
		return
	var hard := amount >= 12.0
	play(&"impact_hard" if hard else &"impact_soft", BUS_SFX,
			clampf(-14.0 + amount * 0.5, -14.0, 0.0), randf_range(0.9, 1.1))


func _on_cash_changed(_new_amount: int, delta: int) -> void:
	if delta > 0:
		play(&"cash", BUS_UI, -4.0)
